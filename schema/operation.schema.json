{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation",
  "description": "One mutation of a document.",
  "oneOf": [
    {
      "description": "Changes the canvas without scaling layers.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "updateCanvas"
        }
      },
      "$ref": "#/$defs/UpdateCanvas",
      "required": [
        "op"
      ]
    },
    {
      "description": "Adds a layer.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "create"
        }
      },
      "$ref": "#/$defs/CreateLayer",
      "required": [
        "op"
      ]
    },
    {
      "description": "Changes properties of an existing layer.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "update"
        }
      },
      "$ref": "#/$defs/UpdateLayer",
      "required": [
        "op"
      ]
    },
    {
      "description": "Removes a layer and everything inside it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to remove.",
          "$ref": "#/$defs/LayerId"
        },
        "op": {
          "type": "string",
          "const": "delete"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    {
      "description": "Copies a layer, and everything inside it, directly above the original.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to copy.",
          "$ref": "#/$defs/LayerId"
        },
        "op": {
          "type": "string",
          "const": "duplicate"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    {
      "description": "Moves a layer by a distance, leaving its size and rotation alone.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to move.",
          "$ref": "#/$defs/LayerId"
        },
        "dx": {
          "description": "Distance along x.",
          "type": "number",
          "format": "double"
        },
        "dy": {
          "description": "Distance along y.",
          "type": "number",
          "format": "double"
        },
        "op": {
          "type": "string",
          "const": "move"
        }
      },
      "required": [
        "op",
        "id",
        "dx",
        "dy"
      ]
    },
    {
      "description": "Sets a layer's box size.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to resize.",
          "$ref": "#/$defs/LayerId"
        },
        "width": {
          "description": "New width.",
          "type": "number",
          "format": "double"
        },
        "height": {
          "description": "New height.",
          "type": "number",
          "format": "double"
        },
        "op": {
          "type": "string",
          "const": "resize"
        }
      },
      "required": [
        "op",
        "id",
        "width",
        "height"
      ]
    },
    {
      "description": "Sets a layer's rotation: the angle to rotate *to*, not by.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to rotate.",
          "$ref": "#/$defs/LayerId"
        },
        "degrees": {
          "description": "Degrees clockwise about the layer's centre.",
          "type": "number",
          "format": "double"
        },
        "op": {
          "type": "string",
          "const": "rotate"
        }
      },
      "required": [
        "op",
        "id",
        "degrees"
      ]
    },
    {
      "description": "Moves a layer elsewhere in the tree: another parent, another z-order,\nor both.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to move.",
          "$ref": "#/$defs/LayerId"
        },
        "to": {
          "description": "Where it should end up.",
          "$ref": "#/$defs/LayerPosition"
        },
        "op": {
          "type": "string",
          "const": "reorder"
        }
      },
      "required": [
        "op",
        "id",
        "to"
      ]
    },
    {
      "description": "Wraps sibling layers in a new group, without moving the picture.",
      "type": "object",
      "properties": {
        "ids": {
          "description": "Layers to wrap. They must currently share a parent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerId"
          }
        },
        "name": {
          "description": "Optional name for the new group.",
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "type": "string",
          "const": "group"
        }
      },
      "required": [
        "op",
        "ids"
      ]
    },
    {
      "description": "Replaces a group with its children, in place.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The group to dissolve.",
          "$ref": "#/$defs/LayerId"
        },
        "op": {
          "type": "string",
          "const": "ungroup"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    {
      "description": "Shows or hides a layer.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to change.",
          "$ref": "#/$defs/LayerId"
        },
        "visible": {
          "description": "Whether it renders.",
          "type": "boolean"
        },
        "op": {
          "type": "string",
          "const": "setVisible"
        }
      },
      "required": [
        "op",
        "id",
        "visible"
      ]
    },
    {
      "description": "Locks or unlocks a layer.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to change.",
          "$ref": "#/$defs/LayerId"
        },
        "locked": {
          "description": "Whether editing operations refuse to touch it.",
          "type": "boolean"
        },
        "op": {
          "type": "string",
          "const": "setLocked"
        }
      },
      "required": [
        "op",
        "id",
        "locked"
      ]
    },
    {
      "description": "Renames a layer, or clears its name.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to rename.",
          "$ref": "#/$defs/LayerId"
        },
        "name": {
          "description": "The new name, or `None` to clear it.",
          "type": [
            "string",
            "null"
          ]
        },
        "op": {
          "type": "string",
          "const": "rename"
        }
      },
      "required": [
        "op",
        "id"
      ]
    },
    {
      "description": "Lines the given layers up on an edge or a centre line.\n\nTakes explicit ids rather than acting on a selection: what an agent\nasked for should be legible in the journal afterwards.",
      "type": "object",
      "properties": {
        "ids": {
          "description": "Layers to line up.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerId"
          }
        },
        "edge": {
          "description": "Which edge or centre line.",
          "$ref": "#/$defs/AlignEdge"
        },
        "op": {
          "type": "string",
          "const": "align"
        }
      },
      "required": [
        "op",
        "ids",
        "edge"
      ]
    },
    {
      "description": "Moves the given layers, as one group, onto the centre of the canvas.",
      "type": "object",
      "properties": {
        "ids": {
          "description": "Layers to move.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerId"
          }
        },
        "axis": {
          "description": "Which axis to centre on.",
          "$ref": "#/$defs/Axis"
        },
        "op": {
          "type": "string",
          "const": "centerOnCanvas"
        }
      },
      "required": [
        "op",
        "ids",
        "axis"
      ]
    },
    {
      "description": "Spreads the given layers out with equal gaps.",
      "type": "object",
      "properties": {
        "ids": {
          "description": "Layers to spread out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerId"
          }
        },
        "axis": {
          "description": "Which axis to spread along.",
          "$ref": "#/$defs/Axis"
        },
        "op": {
          "type": "string",
          "const": "distribute"
        }
      },
      "required": [
        "op",
        "ids",
        "axis"
      ]
    },
    {
      "description": "Moves one layer so it sits against an edge of another layer or of the\ncanvas.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to move.",
          "$ref": "#/$defs/LayerId"
        },
        "target": {
          "description": "What to snap it against.",
          "$ref": "#/$defs/SnapTarget"
        },
        "op": {
          "type": "string",
          "const": "snapTo"
        }
      },
      "required": [
        "op",
        "id",
        "target"
      ]
    },
    {
      "description": "Adds a named style bundle to the document, or replaces one by name.",
      "type": "object",
      "properties": {
        "preset": {
          "description": "The preset to store.",
          "$ref": "#/$defs/Preset"
        },
        "op": {
          "type": "string",
          "const": "definePreset"
        }
      },
      "required": [
        "op",
        "preset"
      ]
    },
    {
      "description": "Removes a named style bundle.\n\nLayers that were styled by it keep their properties: applying a preset\nsets properties, it does not create a link, so deleting one cannot\nchange a picture.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The preset to remove.",
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "deletePreset"
        }
      },
      "required": [
        "op",
        "name"
      ]
    },
    {
      "description": "Declares a named opening in the document, making it a template.\n\nRefused at definition time — not merely reported by validation — for a\nname already taken, a layer that is not there, a kind that does not\nmatch the layer, or **a layer that is protected or read-only**.\n\nThat last refusal is why this is an operation rather than a hand edit.\nFilling a slot is already refused on protected chrome, because a fill\nis an `Update`. Defining one is not a fill, and without this check a\ntemplate could advertise an opening that always fails: the author would\nthink they had offered something, and every variant would refuse.",
      "type": "object",
      "properties": {
        "slot": {
          "description": "The slot to declare.",
          "$ref": "#/$defs/Slot"
        },
        "op": {
          "type": "string",
          "const": "defineSlot"
        }
      },
      "required": [
        "op",
        "slot"
      ]
    },
    {
      "description": "Changes an existing slot, by name.\n\nThe same checks a definition faces, because the result has to be a slot\nthat could have been defined.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Which slot to change.",
          "type": "string"
        },
        "slot": {
          "description": "The slot's new content. Its `name` may differ, which renames it.",
          "$ref": "#/$defs/Slot"
        },
        "op": {
          "type": "string",
          "const": "updateSlot"
        }
      },
      "required": [
        "op",
        "name",
        "slot"
      ]
    },
    {
      "description": "Removes a named opening. The layer it pointed at is untouched.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Which slot to remove.",
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "removeSlot"
        }
      },
      "required": [
        "op",
        "name"
      ]
    },
    {
      "description": "Applies a named style bundle to a layer.\n\nCompiles to the [`Update`](Operation::Update) the preset describes\nbefore anything is changed, which is what makes applying a preset and\nsetting the same properties by hand the same picture — and what makes\na protected layer refuse here without a preset-specific check.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Layer to restyle.",
          "$ref": "#/$defs/LayerId"
        },
        "preset": {
          "description": "Name of the preset to apply.",
          "type": "string"
        },
        "allow_locked": {
          "description": "Apply to a locked layer.",
          "type": "boolean"
        },
        "op": {
          "type": "string",
          "const": "applyPreset"
        }
      },
      "required": [
        "op",
        "id",
        "preset"
      ]
    }
  ],
  "$defs": {
    "Color": {
      "description": "An sRGB colour, `#rrggbb` or `#rrggbbaa`.\n\nStored as written so a document round-trips exactly; validation checks the\nshape and [`Color::to_rgba`] parses it.",
      "type": "string"
    },
    "CanvasAnchor": {
      "description": "The point of the old canvas that stays fixed when its dimensions change.",
      "type": "string",
      "enum": [
        "top-left",
        "top",
        "top-right",
        "left",
        "center",
        "right",
        "bottom-left",
        "bottom",
        "bottom-right"
      ]
    },
    "UpdateCanvas": {
      "description": "Changes canvas properties without scaling any layer.",
      "type": "object",
      "properties": {
        "width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "background": {
          "description": "Absent preserves the background; null clears it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanvasAnchor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LayerPosition": {
      "description": "Where a new layer goes.",
      "oneOf": [
        {
          "description": "At the top level of the document.",
          "type": "object",
          "properties": {
            "index": {
              "description": "Index in the layer list; `None` means on top of everything.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "at": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "at"
          ]
        },
        {
          "description": "Inside a group.",
          "type": "object",
          "properties": {
            "parent": {
              "description": "The group to place it in.",
              "$ref": "#/$defs/LayerId"
            },
            "index": {
              "description": "Index among the group's children; `None` means on top.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "at": {
              "type": "string",
              "const": "in"
            }
          },
          "required": [
            "at",
            "parent"
          ]
        }
      ]
    },
    "LayerId": {
      "description": "Identifier of a layer.",
      "type": "string"
    },
    "Transform": {
      "description": "Position, size, and rotation of a layer in its parent's coordinate space.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Left edge.",
          "type": "number",
          "format": "double"
        },
        "y": {
          "description": "Top edge.",
          "type": "number",
          "format": "double"
        },
        "width": {
          "description": "Box width; must be finite and not negative.",
          "type": "number",
          "format": "double"
        },
        "height": {
          "description": "Box height; must be finite and not negative.",
          "type": "number",
          "format": "double"
        },
        "rotation": {
          "description": "Clockwise rotation in degrees about the box centre.",
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "TextAlign": {
      "description": "Horizontal text alignment inside the layer box.",
      "oneOf": [
        {
          "description": "Aligned to the left edge.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Centred horizontally.",
          "type": "string",
          "const": "center"
        },
        {
          "description": "Aligned to the right edge.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "AssetId": {
      "description": "Identifier of an imported asset.",
      "type": "string"
    },
    "ImageFit": {
      "description": "How an image is scaled into its box.",
      "oneOf": [
        {
          "description": "Stretch to the box, ignoring aspect ratio.",
          "type": "string",
          "const": "fill"
        },
        {
          "description": "Scale down to fit inside the box, keeping aspect ratio.",
          "type": "string",
          "const": "contain"
        },
        {
          "description": "Scale to cover the box, keeping aspect ratio, cropping the overflow.",
          "type": "string",
          "const": "cover"
        }
      ]
    },
    "CreateLayer": {
      "description": "Add a layer to the document.",
      "type": "object",
      "properties": {
        "position": {
          "description": "Where it goes.",
          "$ref": "#/$defs/LayerPosition",
          "default": {
            "at": "root"
          }
        },
        "transform": {
          "description": "Its box in the parent's coordinate space.",
          "$ref": "#/$defs/Transform"
        },
        "name": {
          "description": "Optional human-facing name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "transform"
      ],
      "oneOf": [
        {
          "description": "A text layer.",
          "type": "object",
          "properties": {
            "text": {
              "description": "The text; `\\n` starts a new line.",
              "type": "string"
            },
            "fontFamily": {
              "description": "Font family, resolved at render time against the caller's fonts.",
              "type": "string"
            },
            "fontSize": {
              "description": "Font size in pixels.",
              "type": "number",
              "format": "double"
            },
            "color": {
              "description": "Fill colour.",
              "$ref": "#/$defs/Color",
              "default": "#000000"
            },
            "align": {
              "description": "Horizontal alignment in the box.",
              "$ref": "#/$defs/TextAlign",
              "default": "left"
            },
            "lineHeight": {
              "description": "Line height as a multiple of the font size.",
              "type": "number",
              "format": "double",
              "default": 1.2
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text",
            "fontFamily",
            "fontSize"
          ]
        },
        {
          "description": "An image layer referencing an asset already in the document.",
          "type": "object",
          "properties": {
            "asset": {
              "description": "The asset to draw.",
              "$ref": "#/$defs/AssetId"
            },
            "fit": {
              "description": "How it fills its box.",
              "$ref": "#/$defs/ImageFit",
              "default": "fill"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "asset"
          ]
        },
        {
          "description": "An empty group.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "A vector graphic layer referencing an imported SVG asset.",
          "type": "object",
          "properties": {
            "asset": {
              "description": "The asset to draw.",
              "$ref": "#/$defs/AssetId"
            },
            "fit": {
              "description": "How it fills its box.",
              "$ref": "#/$defs/ImageFit",
              "default": "fill"
            },
            "type": {
              "type": "string",
              "const": "svg"
            }
          },
          "required": [
            "type",
            "asset"
          ]
        }
      ]
    },
    "BlendMode": {
      "description": "How a layer composites onto what is beneath it.\n\nThe whole CSS separable-and-non-separable set, every one of which was\nchecked to rasterize before it was named here — a mode that only\nround-trips would be a promise the pixels do not keep.\n\n[`BlendMode::Other`] is what a mode written by some newer build becomes:\npreserved verbatim, because losing it would mean a document came back\ndamaged, but **refused at render time** rather than quietly composited as\n`normal`. Silently drawing the wrong thing is the worse failure: it looks\nlike it worked.",
      "anyOf": [
        {
          "description": "Plain source-over compositing.",
          "type": "string",
          "const": "normal"
        },
        {
          "description": "Darkens: multiplies the two colours.",
          "type": "string",
          "const": "multiply"
        },
        {
          "description": "Lightens: the inverse of multiplying the inverses.",
          "type": "string",
          "const": "screen"
        },
        {
          "description": "Multiplies or screens, depending on the backdrop.",
          "type": "string",
          "const": "overlay"
        },
        {
          "description": "Keeps the darker of the two.",
          "type": "string",
          "const": "darken"
        },
        {
          "description": "Keeps the lighter of the two.",
          "type": "string",
          "const": "lighten"
        },
        {
          "description": "Brightens the backdrop to reflect the source.",
          "type": "string",
          "const": "color-dodge"
        },
        {
          "description": "Darkens the backdrop to reflect the source.",
          "type": "string",
          "const": "color-burn"
        },
        {
          "description": "`Overlay` with the layers swapped.",
          "type": "string",
          "const": "hard-light"
        },
        {
          "description": "A softer `HardLight`.",
          "type": "string",
          "const": "soft-light"
        },
        {
          "description": "The absolute difference of the two.",
          "type": "string",
          "const": "difference"
        },
        {
          "description": "Like `Difference`, with less contrast.",
          "type": "string",
          "const": "exclusion"
        },
        {
          "description": "The source's hue, the backdrop's saturation and luminosity.",
          "type": "string",
          "const": "hue"
        },
        {
          "description": "The source's saturation, the backdrop's hue and luminosity.",
          "type": "string",
          "const": "saturation"
        },
        {
          "description": "The source's hue and saturation, the backdrop's luminosity.",
          "type": "string",
          "const": "color"
        },
        {
          "description": "The source's luminosity, the backdrop's hue and saturation.",
          "type": "string",
          "const": "luminosity"
        },
        {
          "description": "A mode this build does not render, preserved as written and refused\nwhen something tries to draw it.",
          "type": "string"
        }
      ]
    },
    "Effect": {
      "description": "One adjustment in a layer's effect stack.\n\nTagged by `type`, so the JSON reads as what it is. [`Effect::Other`] keeps\nan effect written by a newer build verbatim and refuses to render it —\nthe same bargain as [`BlendMode::Other`]: never lose it, never guess at it.\n\nThe amounts are multipliers where 1 means \"unchanged\", which is what\n`filter: brightness(1.2)` means everywhere else, so a number copied from a\nCSS example does what it looks like it does.",
      "anyOf": [
        {
          "description": "Scales each channel. 1 is unchanged, 0 is black.",
          "type": "object",
          "properties": {
            "amount": {
              "description": "The multiplier.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "brightness"
            }
          },
          "required": [
            "type",
            "amount"
          ]
        },
        {
          "description": "Pushes each channel away from mid grey. 1 is unchanged, 0 is flat grey.",
          "type": "object",
          "properties": {
            "amount": {
              "description": "The multiplier.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "contrast"
            }
          },
          "required": [
            "type",
            "amount"
          ]
        },
        {
          "description": "Scales colourfulness. 1 is unchanged, 0 is greyscale.",
          "type": "object",
          "properties": {
            "amount": {
              "description": "The multiplier.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "saturation"
            }
          },
          "required": [
            "type",
            "amount"
          ]
        },
        {
          "description": "A Gaussian blur.",
          "type": "object",
          "properties": {
            "radius": {
              "description": "Standard deviation, in document units. 0 does nothing.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "blur"
            }
          },
          "required": [
            "type",
            "radius"
          ]
        },
        {
          "description": "Seeded monochrome noise, multiplied over the layer.\n\nThe seed is part of the document, not the run: the same document\nproduces the same grain on every machine and in every render (NFR-3).\nGrain from a clock or a random number generator would quietly break\nthe one property this project is built on.",
          "type": "object",
          "properties": {
            "amount": {
              "description": "How far the noise swings either side of unchanged, 0 to 1.",
              "type": "number",
              "format": "double"
            },
            "seed": {
              "description": "The noise seed.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "scale": {
              "description": "Size of the noise features; 1 is fine grain, larger is coarser.",
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "grain"
            }
          },
          "required": [
            "type",
            "amount",
            "seed"
          ]
        },
        {
          "description": "An effect this build does not know, preserved as written and refused\nwhen something tries to draw it."
        }
      ]
    },
    "UpdateLayer": {
      "description": "Change properties of an existing layer.\n\nEvery field is optional and means \"leave alone\" when absent. `name` is\ndoubly optional: `Some(None)` clears the name, `None` leaves it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The layer to change.",
          "$ref": "#/$defs/LayerId"
        },
        "name": {
          "description": "New name, or `Some(None)` to remove it.",
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "description": "Replace the whole transform.",
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "description": "New opacity.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "visible": {
          "description": "Show or hide.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "locked": {
          "description": "Lock or unlock.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "blendMode": {
          "description": "How the layer composites onto what is beneath it.\n\nA mode this build does not render is refused here, so a value that\nwould fail at render time cannot get into a document through this\nbuild in the first place.",
          "anyOf": [
            {
              "$ref": "#/$defs/BlendMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "description": "Replace the whole effect stack.\n\nThe whole stack rather than one effect at a time: order is part of the\nmeaning — a blurred thing desaturated is not a desaturated thing\nblurred — and an insert-at-index operation would be a second, subtler\nway of saying what this already says. Undo restores the previous stack\nlike any other property.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "text": {
          "description": "Text layers: new text.",
          "type": [
            "string",
            "null"
          ]
        },
        "fontFamily": {
          "description": "Text layers: new font family.",
          "type": [
            "string",
            "null"
          ]
        },
        "fontSize": {
          "description": "Text layers: new font size.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "color": {
          "description": "Text layers: new colour.",
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "align": {
          "description": "Text layers: new alignment.",
          "anyOf": [
            {
              "$ref": "#/$defs/TextAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineHeight": {
          "description": "Text layers: new line height.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "fit": {
          "description": "Image layers: new fit.",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageFit"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset": {
          "description": "Image and SVG layers: draw a different asset.\n\nThe asset must already be in the document — importing is not an\noperation (it copies a file, which is not reversible), so swapping to\nsomething that was never imported is refused rather than half-done.",
          "anyOf": [
            {
              "$ref": "#/$defs/AssetId"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowLocked": {
          "description": "Change the layer even though it is locked.\n\nNeeded to unlock a layer at all, and kept explicit so that no ordinary\nedit slips past a lock by accident.",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ]
    },
    "AlignEdge": {
      "description": "Which edge or axis an alignment lines up.",
      "oneOf": [
        {
          "description": "Left edges.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Right edges.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "Top edges.",
          "type": "string",
          "const": "top"
        },
        {
          "description": "Bottom edges.",
          "type": "string",
          "const": "bottom"
        },
        {
          "description": "Horizontal centres.",
          "type": "string",
          "const": "centerHorizontal"
        },
        {
          "description": "Vertical centres.",
          "type": "string",
          "const": "centerVertical"
        }
      ]
    },
    "Axis": {
      "description": "Which way an operation works.",
      "oneOf": [
        {
          "description": "Left to right.",
          "type": "string",
          "const": "horizontal"
        },
        {
          "description": "Top to bottom.",
          "type": "string",
          "const": "vertical"
        },
        {
          "description": "Both at once.",
          "type": "string",
          "const": "both"
        }
      ]
    },
    "SnapTarget": {
      "description": "What a layer is snapped to.",
      "oneOf": [
        {
          "description": "An edge of another layer.",
          "type": "object",
          "properties": {
            "id": {
              "description": "The layer to snap against.",
              "$ref": "#/$defs/LayerId"
            },
            "edge": {
              "description": "Which of its edges.",
              "$ref": "#/$defs/AlignEdge"
            },
            "to": {
              "type": "string",
              "const": "layer"
            }
          },
          "required": [
            "to",
            "id",
            "edge"
          ]
        },
        {
          "description": "An edge of the canvas.",
          "type": "object",
          "properties": {
            "edge": {
              "description": "Which canvas edge.",
              "$ref": "#/$defs/AlignEdge"
            },
            "to": {
              "type": "string",
              "const": "canvas"
            }
          },
          "required": [
            "to",
            "edge"
          ]
        }
      ]
    },
    "Preset": {
      "description": "A named bundle of style properties.",
      "type": "object",
      "properties": {
        "name": {
          "description": "What it is called. Unique within a document.",
          "type": "string"
        },
        "description": {
          "description": "What it is for, for whoever is choosing between presets — including an\nagent, which is the case that needs it most.",
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "description": "The properties it sets. Anything left out is left alone on apply.",
          "$ref": "#/$defs/PresetProperties"
        }
      },
      "required": [
        "name",
        "properties"
      ],
      "additionalProperties": true
    },
    "PresetProperties": {
      "description": "What a preset sets.\n\nEvery field optional, and absent means \"leave alone\" — so a preset that\nonly names a colour is a colour preset, and applying it does not quietly\nreset a layer's font.\n\nDeliberately no transform: a style is not a position. A preset that moved\nlayers would be a template, and templates already exist.",
      "type": "object",
      "properties": {
        "fontFamily": {
          "description": "Text layers: font family.",
          "type": [
            "string",
            "null"
          ]
        },
        "fontSize": {
          "description": "Text layers: font size.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "color": {
          "description": "Text layers: fill colour.",
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "align": {
          "description": "Text layers: horizontal alignment.",
          "anyOf": [
            {
              "$ref": "#/$defs/TextAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineHeight": {
          "description": "Text layers: line height.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "opacity": {
          "description": "Any layer: opacity.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "blendMode": {
          "description": "Any layer: how it composites.",
          "anyOf": [
            {
              "$ref": "#/$defs/BlendMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "description": "Any layer: the whole effect stack.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Effect"
          }
        }
      },
      "additionalProperties": true
    },
    "Slot": {
      "description": "A named opening in a template.",
      "type": "object",
      "properties": {
        "name": {
          "description": "What a caller names this slot by. Unique within a document.",
          "type": "string"
        },
        "layer": {
          "description": "The layer it fills.",
          "$ref": "#/$defs/LayerId"
        },
        "kind": {
          "description": "What may be supplied for it.",
          "$ref": "#/$defs/SlotKind",
          "default": "text"
        },
        "description": {
          "description": "What this slot is for, for whoever is filling it — including an agent,\nwhich is the case that needs it most.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether a variant must supply it.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name",
        "layer"
      ],
      "additionalProperties": true
    },
    "SlotKind": {
      "description": "What a slot lets a caller supply.",
      "oneOf": [
        {
          "description": "The text of a text layer.",
          "type": "string",
          "const": "text"
        },
        {
          "description": "The asset an image layer draws.",
          "type": "string",
          "const": "image"
        },
        {
          "description": "The fill colour of a text layer.",
          "type": "string",
          "const": "color"
        }
      ]
    }
  }
