# Normalize line endings: LF in the repository, native in the working tree.
# This matters because development targets both Windows and Linux (NFR-2).
* text=auto eol=lf

# Windows-only files keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF even on Windows checkouts.
*.sh text eol=lf

# Explicit text types.
*.md       text
*.json     text
*.jsonc    text
*.yml      text
*.yaml     text
*.ts       text
*.tsx      text
*.js       text
*.jsx      text
*.py       text
*.toml     text
*.svg      text

# Binary assets — never diff or convert these.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.avif     binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.assemblash binary

# Keep repository-only files out of source archives / published packages.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.editorconfig  export-ignore
