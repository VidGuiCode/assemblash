{
  "name": "assemblash-ui",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "description": "Reference interface for Assemblash. React and Mantine components bundle with Vite. The output is committed for offline binary embedding.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && node copy-static.mjs",
    "test": "tsc -p tsconfig.test.json && node --test *.test.mjs",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/dropzone": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
